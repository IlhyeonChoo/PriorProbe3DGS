# Python bytecode and native extensions
__pycache__/
*.py[cod]
*.so

# Build and packaging artifacts
build/
dist/
*.egg-info/

# Virtual environments and tooling caches
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# ML and research binaries
*.pt
*.pth
*.ckpt
*.npy
*.npz
*.pkl
*.safetensors
*.onnx

# Archives and partial downloads
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.part*
*.corrupt

# Data: keep documentation, placeholders, and lightweight metadata only
/data/**
!/data/
!/data/**/
!/data/**/README.md
!/data/**/.gitkeep
!/data/**/scene_meta.json

# Outputs: keep summarized reports only, ignore run artifacts
!/outputs/
!/outputs/.gitkeep
/outputs/**/backend_runs/
/outputs/**/experiments/
/outputs/**/prior_library/
/outputs/**/legacy_misc/
/outputs/**/inspection/
/outputs/**/._*

# Logs
/logs/**
!/logs/
!/logs/.gitkeep

# Local assistant and staging scratch files
/CLAUDE.md
/AGENTS.md
/docs/git_staging_guide*.md
*.txt
